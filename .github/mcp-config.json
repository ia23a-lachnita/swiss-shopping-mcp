{
  "mcpServers": {
    "context7": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {},
      "tools": ["*"]
    },
    "context-mode": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "context-mode"],
      "env": {},
      "tools": ["*"]
    },
    "antigravity-mcp": {
      "type": "local",
      "command": "node",
      "args": ["C:\\Users\\xursc\\projects\\antigravity-mcp\\dist\\index.js"],
      "env": {
        "GEMINI_BACKEND": "agy",
        "GEMINI_MCP_APPROVAL_MODE": "yolo"
      },
      "tools": ["*"]
    }
  }
}
