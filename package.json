{
  "name": "swiss-shopping-mcp",
  "version": "0.1.0",
  "description": "Swiss grocery and shopping MCP with multi-chain support, price comparison, and account integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "swiss-shopping-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:pwa": "tsc -p pwa && vite build --config pwa/vite.config.ts",
    "dev:pwa": "vite --config pwa/vite.config.ts",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "test": "vitest",
    "test:live": "LIVE_SOURCE_TESTS=1 vitest run --passWithNoTests src/adapters/live/*.live.test.ts",
    "test:live:denner": "vitest run --passWithNoTests src/adapters/live/dennerPromotionsAdapter.live.test.ts",
    "test:integration": "vitest run --passWithNoTests src/**/*.integration.test.ts",
    "test:contract": "RUN_CONTRACT_TESTS=1 vitest run --passWithNoTests src/**/*.contract.test.ts",
    "test:ui": "vitest --ui",
    "test:browser": "npx playwright test",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "start:web": "tsc && node dist/web/server.js"
  },
  "keywords": [
    "mcp",
    "grocery",
    "shopping",
    "switzerland",
    "price-comparison",
    "migros",
    "coop",
    "aldi",
    "denner",
    "lidl"
  ],
  "author": "Project maintainers",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "migros-api-wrapper": "^1.1.37",
    "playwright-core": "^1.61.1",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^8.54.0",
    "framer-motion": "^12.42.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "prettier": "^3.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.3.2",
    "vaul": "^1.1.2",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^1.0.0"
  }
}
